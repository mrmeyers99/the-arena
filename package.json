{
  "name": "the-arena",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "size": "size-limit",
    "preview": "vite preview",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:rules": "firebase emulators:exec --only firestore --project demo-the-arena 'vitest run --config vitest.rules.config.js'"
  },
  "dependencies": {
    "firebase": "^10.12.2",
    "lucide-react": "^0.577.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@size-limit/file": "^14.3.0",
    "@firebase/rules-unit-testing": "^3.0.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "~6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^4.1.12",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.0",
    "firebase-tools": "^15.36.0",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^17.0.0",
    "postcss": "^8.4.38",
    "prettier": "^3.10.1",
    "size-limit": "^14.3.0",
    "tailwindcss": "^3.4.4",
    "vite": "^6.0.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "undici": "^6.29.1",
    "@grpc/grpc-js": "^1.14.7"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "prettier --write",
      "eslint --max-warnings 0"
    ],
    "*.{json,css,md,html,yml,yaml}": "prettier --write"
  }
}

{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "schedule": ["before 6am on monday"],
  "labels": ["dependencies"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "dependencyDashboard": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": ["at any time"],
    "labels": ["security"]
  },
  "osvVulnerabilityAlerts": true,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on the first day of the month"]
  },
  "packageRules": [
    {
      "description": "Group non-major devDependency updates and automerge once CI passes",
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "non-major dev dependencies",
      "automerge": true
    },
    {
      "description": "Group non-major production dependency updates into one PR (manual review)",
      "matchManagers": ["npm"],
      "matchDepTypes": ["dependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "non-major production dependencies",
      "automerge": false
    },
    {
      "description": "Group Firebase packages together",
      "matchPackageNames": ["firebase", "@firebase/**", "firebase-tools"],
      "groupName": "firebase"
    },
    {
      "description": "Group React packages together",
      "matchPackageNames": ["react", "react-dom", "@types/react", "@types/react-dom"],
      "groupName": "react"
    },
    {
      "description": "Group ESLint-related packages together",
      "matchPackageNames": [
        "eslint",
        "@eslint/**",
        "eslint-plugin-*",
        "eslint-config-*",
        "typescript-eslint",
        "@typescript-eslint/**",
        "globals"
      ],
      "groupName": "eslint"
    },
    {
      "description": "Group Vite and its plugins together",
      "matchPackageNames": ["vite", "@vitejs/**"],
      "groupName": "vite"
    },
    {
      "description": "Pin GitHub Actions to digests, group their updates, and automerge non-major/digest updates",
      "matchManagers": ["github-actions"],
      "groupName": "github actions",
      "automerge": true
    },
    {
      "description": "Major updates get their own PRs, are labeled, and never automerge",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "addLabels": ["major"]
    }
  ]
}
